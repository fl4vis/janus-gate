{
  "manifest_version": 3,
  "name": "Janus Gate",
  "version": "1.0.0",
  "description": "Activa, deactiva, et rege conexionem retis Janus per SOCKS5, ex instrumentorum ordine",
  "permissions": ["proxy", "storage", "webRequest" ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "./icons/janus_icon16.png",
    "32": "./icons/janus_icon32.png",
    "48": "./icons/janus_icon48.png",
    "128": "./icons/janus_icon128.png"
  },
  "options_page": "options/options.html"
}
